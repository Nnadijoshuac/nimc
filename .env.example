# =============================================================================
# NIN Support Atlanta: environment template
#
# 1. Copy this file to .env.local (git-ignored) and fill in every value.
# 2. Website: Vite reads the VITE_* values. Only VITE_* values ever reach the
#    browser; everything else in this file stays private.
# 3. Email functions: push the server secrets to Supabase with
#      npx supabase secrets set --env-file .env.local
# 4. Hosting: the public site and the back office deploy separately
#    (npm run build / npm run build:admin); set the VITE_* values on both.
#
# Full setup guide: docs/BACKEND.md
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE (database + staff login)
# Where: https://supabase.com/dashboard -> your project -> Project Settings -> API
# -----------------------------------------------------------------------------

# "Project URL"
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# "anon public" key (or the "publishable" key, sb_publishable_...).
# Safe to expose: row level security blocks anonymous access to all data.
VITE_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# Public website address. The back office uses it to build resume links, so it
# must be the public site, not the admin address.
VITE_PUBLIC_SITE_URL="https://www.ninsupportatalanta.com"


# -----------------------------------------------------------------------------
# RESEND (emails to applicants and staff), server-side only
# Where: https://resend.com -> API Keys -> Create API Key (Sending access)
# -----------------------------------------------------------------------------

# SECRET. Starts with re_. Never prefix with VITE_.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address. The domain must be verified in Resend -> Domains.
# Before verification, use: NIN Support Atlanta <onboarding@resend.dev>
# (that only delivers to the email you signed up to Resend with).
EMAIL_FROM="NIN Support Atlanta <noreply@ninsupportatalanta.com>"


# -----------------------------------------------------------------------------
# EMAIL ROUTING (your choice, no lookup needed)
# -----------------------------------------------------------------------------

# Inboxes alerted on every new submission (comma-separated).
STAFF_NOTIFY_EMAILS="info@ninsupportatalanta.com"

# Where applicants' replies land. Defaults to the first STAFF_NOTIFY_EMAILS.
EMAIL_REPLY_TO="info@ninsupportatalanta.com"

# The staff back office (a separate app/address), linked from staff emails.
ADMIN_DASHBOARD_URL="https://admin.ninsupportatalanta.com"

# Sites allowed to call the functions: public site, back office, and local dev (comma-separated).
ALLOWED_ORIGINS="https://www.ninsupportatalanta.com,https://ninsupportatalanta.com,https://admin.ninsupportatalanta.com,http://localhost:3000,http://localhost:3001"


# -----------------------------------------------------------------------------
# Provided by Supabase automatically inside the functions. Do NOT set these:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# -----------------------------------------------------------------------------
